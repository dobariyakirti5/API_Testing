Task 3: Data-driven login testing for a movie booking app:-


{
  "email": "{{email}}",
  "password": "{{password}}"
}


const testData = pm.iterationData;
const expectedResult = testData.get("expectedResult");
const statusCode = pm.response.code;

let loginSucceeded = statusCode >= 200 && statusCode < 300;

console.log(
    "Email:", testData.get("email") || "(empty)",
    "| Expected:", expectedResult,
    "| Actual:", loginSucceeded ? "success" : "failure",
    "| Status:", statusCode
);

pm.test("Login result matches expected result", function () {
    if (expectedResult === "success") {
        pm.expect(loginSucceeded).to.be.true;
    } else {
        pm.expect(loginSucceeded).to.be.false;
    }
});

