 Task 5: Chain Login, Fetch Playlists, and Add a Song:-





```javascript
const BASE_URL = "https://api.example.com";

async function musicWorkflow() {

    // Step 1: Login
    const loginResponse = await fetch(`${BASE_URL}/login`, {
        method: "POST",
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify({
            email: "test@example.com",
            password: "TestPass123"
        })
    });

    if (!loginResponse.ok) {
        throw new Error(`Login failed: ${loginResponse.status}`);
    }

    const loginData = await loginResponse.json();
    const token = loginData.token;

    if (!token) {
        throw new Error("Login response did not contain a token.");
    }

    console.log("Login successful.");

    // Step 2: Fetch playlists
    const playlistResponse = await fetch(
        `${BASE_URL}/playlists`,
        {
            method: "GET",
            headers: {
                Authorization: `Bearer ${token}`
            }
        }
    );

    if (!playlistResponse.ok) {
        throw new Error(
            `Playlist request failed: ${playlistResponse.status}`
        );
    }

    const playlists = await playlistResponse.json();

    if (!Array.isArray(playlists) || playlists.length === 0) {
        throw new Error("No playlists found.");
    }

    const playlistId = playlists[0].id;
    const songId = 1001;

    console.log("Playlist ID:", playlistId);

    // Step 3: Add a song to the playlist
    const addSongResponse = await fetch(
        `${BASE_URL}/playlists/${playlistId}/songs`,
        {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                Authorization: `Bearer ${token}`
            },
            body: JSON.stringify({
                songId: songId
            })
        }
    );

    if (!addSongResponse.ok) {
        throw new Error(
            `Adding song failed: ${addSongResponse.status}`
        );
    }

    const result = await addSongResponse.json();

    console.log("Song added successfully.");
    console.log("Song ID:", songId);
    console.log("Result:", result);
}

musicWorkflow().catch(error => {
    console.error("Music workflow failed:", error.message);
});
```



