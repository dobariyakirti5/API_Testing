 Task 2: Automate a Product Purchase Using REST Assured in Java:-


Create a Maven project with REST Assured and JUnit 5 dependencies. Add this Java class:

**File:** `ProductPurchaseTest.java`

```java
import io.restassured.http.ContentType;
import io.restassured.path.json.JsonPath;
import org.junit.jupiter.api.Test;

import static io.restassured.RestAssured.given;
import static org.hamcrest.Matchers.*;

public class ProductPurchaseTest {

    private static final String BASE_URL =
            "https://api.example.com";

    @Test
    public void purchaseProductWorkflow() {

        // Step 1: Add product to cart
        String cartResponse =
            given()
                .baseUri(BASE_URL)
                .contentType(ContentType.JSON)
                .body("""
                    {
                      "productId": 101,
                      "quantity": 1
                    }
                    """)
            .when()
                .post("/cart")
            .then()
                .statusCode(anyOf(is(200), is(201)))
                .extract()
                .asString();

        JsonPath cartData = new JsonPath(cartResponse);

        int cartId = cartData.getInt("cartId");
        int productId = cartData.getInt("productId");

        System.out.println("Cart ID: " + cartId);
        System.out.println("Product ID: " + productId);

        // Step 2: Update cart quantity
        given()
            .baseUri(BASE_URL)
            .contentType(ContentType.JSON)
            .body("""
                {
                  "productId": %d,
                  "quantity": 2
                }
                """.formatted(productId))
        .when()
            .put("/cart/" + cartId)
        .then()
            .statusCode(200)
            .body("cartId", equalTo(cartId));

        // Step 3: Place order
        given()
            .baseUri(BASE_URL)
            .contentType(ContentType.JSON)
            .body("""
                {
                  "cartId": %d,
                  "productId": %d,
                  "quantity": 2
                }
                """.formatted(cartId, productId))
        .when()
            .post("/orders")
        .then()
            .statusCode(anyOf(is(200), is(201)))
            .body("orderId", notNullValue());

        System.out.println("Purchase workflow completed.");
    }
}
```


 Task 3: Simulate a Movie Ticket Booking Workflow Using Python:-


Install the required library:

```bash
pip install requests
```

**File:** `movie_booking.py`

```python
import requests

BASE_URL = "https://api.example.com"
session = requests.Session()

try:
    # Step 1: Search for a movie
    movie_response = session.get(
        f"{BASE_URL}/movies/search",
        params={"title": "Example Movie"},
        timeout=15
    )
    movie_response.raise_for_status()

    movies = movie_response.json()

    if not movies:
        raise ValueError("No movies found.")

    movie_id = movies[0]["id"]
    print("Movie ID:", movie_id)

    # Step 2: Select seats
    seat_response = session.post(
        f"{BASE_URL}/seats/select",
        json={
            "movieId": movie_id,
            "seats": ["A1", "A2"]
        },
        timeout=15
    )
    seat_response.raise_for_status()

    seat_data = seat_response.json()
    seat_selection_id = seat_data["seatSelectionId"]

    print("Seat Selection ID:", seat_selection_id)

    # Step 3: Confirm booking
    booking_response = session.post(
        f"{BASE_URL}/bookings",
        json={
            "movieId": movie_id,
            "seatSelectionId": seat_selection_id,
            "seats": ["A1", "A2"]
        },
        timeout=15
    )
    booking_response.raise_for_status()

    booking_data = booking_response.json()

    print("Booking successful.")
    print("Booking ID:", booking_data.get("bookingId"))
    print("Response:", booking_data)

except requests.RequestException as error:
    print("API request failed:", error)

except (KeyError, ValueError) as error:
    print("Invalid response or workflow data:", error)
```


