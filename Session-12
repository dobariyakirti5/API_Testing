public class SoldOutBookingTest {

    @Test
    public void bookingSoldOutSeatShouldFail() {

        Response response = given()
                .baseUri("https://your-api.example.com")
                .contentType("application/json")
                .body("{\"showId\":\"SOLD_OUT_SHOW\","
                    + "\"seatIds\":[\"A1\"]}")
                .when()
                .post("/bookings");

        Assert.assertEquals(response.getStatusCode(), 409,
                "Sold-out booking should return conflict");

        String message = response.jsonPath()
                .getString("message");

        Assert.assertEquals(message, "Show is sold out",
                "Correct sold-out error should be returned");
    }
}
