### C. Place an Order

**Method:** POST

**URL:**
```text
{{base_url}}/orders
```

**Headers:**
```text
Content-Type: application/json
Authorization: Bearer {{user_token}}
```

**Request body — raw JSON:**
```json
{
  "restaurantId": 1,
  "items": [
    {
      "productId": 101,
      "quantity": 2
    }
  ],
  "deliveryAddress": "Ahmedabad, Gujarat"
}
```

**Positive test — valid order**

```javascript
pm.test("Order created successfully", function () {
    pm.expect(pm.response.code).to.be.oneOf([200, 201]);
});

pm.test("Order ID is returned", function () {
    const data = pm.response.json();
    pm.expect(data.orderId).to.exist;
});
```

**Negative test — invalid order data**

Use a separate POST request with this body:

```json
{
  "restaurantId": -1,
  "items": [],
  "deliveryAddress": ""
}
```

```javascript
pm.test("Invalid order is rejected", function () {
    pm.expect(pm.response.code).to.be.oneOf([400, 422]);
});
```


 2. REST Assured: Flipkart-Style Product Search API:-


```java
import io.restassured.RestAssured;
import io.restassured.response.Response;

import org.testng.Assert;
import org.testng.annotations.BeforeClass;
import org.testng.annotations.Test;

import static io.restassured.RestAssured.given;

public class ProductSearchTest {

    @BeforeClass
    public void setup() {
        RestAssured.baseURI = "https://your-api.example.com";
    }

    @Test
    public void searchMatchingProducts() {

        Response response = given()
                .queryParam("keyword", "phone")
                .when()
                .get("/products/search");

        Assert.assertEquals(response.getStatusCode(), 200);

        String body = response.getBody().asString();
        Assert.assertTrue(body.contains("products"));

        int count = response.jsonPath()
                .getList("products").size();

        Assert.assertTrue(count > 0,
                "Matching products should be returned");

        for (int i = 0; i < count; i++) {
            String productName = response.jsonPath()
                    .getString("products[" + i + "].name");

            Assert.assertTrue(
                    productName.toLowerCase().contains("phone"),
                    "Every returned product should match the keyword"
            );
        }
    }

    @Test
    public void searchNoMatchingProducts() {

        Response response = given()
                .queryParam("keyword", "xyznotfound999")
                .when()
                .get("/products/search");

        Assert.assertEquals(response.getStatusCode(), 200);

        int count = response.jsonPath()
                .getList("products").size();

        Assert.assertEquals(count, 0,
                "No products should match the unknown keyword");
    }
}
```


