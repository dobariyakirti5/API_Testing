Task 4: Use environment variables for product details:-


GET {{baseUrl}}/products/{{productId}}


pm.test("Product request returns 200", function () {
    pm.response.to.have.status(200);
});

pm.test("Product response contains an ID", function () {
    const product = pm.response.json();

    pm.expect(product).to.have.property("id");
    pm.expect(Number(product.id)).to.eql(
        Number(pm.environment.get("productId"))
    );
});

console.log("Base URL:", pm.environment.get("baseUrl"));
console.log("Product ID:", pm.environment.get("productId"));

