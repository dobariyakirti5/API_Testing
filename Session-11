 3. API Test — `ApiTest.java`:-


```java
import io.qameta.allure.testng.AllureTestNg;
import io.restassured.RestAssured;
import io.restassured.filter.Filter;
import io.restassured.response.Response;
import io.restassured.specification.FilterableRequestSpecification;
import io.restassured.specification.FilterableResponseSpecification;

import org.apache.logging.log4j.LogManager;
import org.apache.logging.log4j.Logger;
import org.testng.Assert;
import org.testng.annotations.Listeners;
import org.testng.annotations.Test;

@Listeners(AllureTestNg.class)
public class ApiTest {

    private static final Logger log =
            LogManager.getLogger(ApiTest.class);

    private static final Filter apiLoggingFilter =
        (FilterableRequestSpecification request,
         FilterableResponseSpecification responseSpec,
         io.restassured.filter.FilterContext context) -> {

            log.info("REQUEST: {} {}",
                    request.getMethod(), request.getURI());

            if (request.getBody() != null) {
                log.info("REQUEST BODY: {}", request.getBody());
            }

            Response response = context.next(request, responseSpec);

            log.info("RESPONSE STATUS: {}", response.getStatusCode());
            log.info("RESPONSE BODY: {}", response.getBody().asString());

            return response;
        };

    @Test(description = "Verify GET post API")
    public void getPostTest() {
        log.debug("Starting GET post test");

        RestAssured.given()
                .filter(apiLoggingFilter)
                .baseUri("https://jsonplaceholder.typicode.com")
                .when()
                .get("/posts/1")
                .then()
                .statusCode(200);

        log.info("GET post test completed");
    }

    @Test(description = "Verify post response body")
    public void verifyPostBody() {
        Response response = RestAssured.given()
                .filter(apiLoggingFilter)
                .baseUri("https://jsonplaceholder.typicode.com")
                .when()
                .get("/posts/1");

        Assert.assertEquals(response.getStatusCode(), 200);
        Assert.assertEquals(response.jsonPath().getInt("id"), 1);
        Assert.assertNotNull(response.jsonPath().getString("title"));

        log.info("Post response body validation passed");
    }

    // Temporary test for logging verification.
    // Remove or correct it after checking the output.
    @Test
    public void verifyLoggingOnFailure() {
        log.debug("Debug message");
        log.info("Info message");
        log.warn("Warning message");
        log.error("Error message");

        Assert.assertEquals(500, 200,
                "Intentional failure to verify logging");
    }
}
```

 4. Logging Configuration — `log4j2.xml`:-



```xml
<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout
                pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %c{1} - %msg%n"/>
        </Console>
    </Appenders>

    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
```


 5. Generate Allure HTML Report:-

Run these commands from your project directory:

```bash
mvn clean test
mvn allure:report
```

The HTML report should be generated at:

```text
target/site/allure-maven-plugin/index.html
```

The raw Allure results should be available in:

```text
target/allure-results/
```


```bash
allure serve target/allure-results
```

 6. GitHub Actions CI Workflow — `api-tests.yml`:-


```yaml
name: API Testing CI

on:
  push:
    branches: ["main"]
  pull_request:
    branches: ["main"]
  workflow_dispatch:

jobs:
  api-tests:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"
          cache: maven

      - name: Run API tests
        run: mvn clean test

      - name: Generate Allure HTML report
        if: always()
        run: mvn allure:report

      - name: Upload Allure report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: allure-html-report
          path: target/site/allure-maven-plugin/
          if-no-files-found: warn

      - name: Upload Allure raw results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: allure-results
          path: target/allure-results/
          if-no-files-found: warn
```

Push the project to your GitHub repository:

```bash
git add .
git commit -m "Add API tests and Allure reporting"
git push origin main
```


